<!-- components/address-select/address-select.wxml -->
<view class="address-select-overlay" wx:if="{{show}}" bindtap="close">
  <view class="address-select-panel" catchtap="preventBubble">
    <!-- 标题栏 -->
    <view class="panel-header">
      <view class="header-title">选择地址信息</view>
      <view class="close-btn" bindtap="close">
        <text class="close-icon">×</text>
      </view>
    </view>
    
    <!-- 内容区域 -->
    <view class="panel-content">
      <!-- 加载状态 -->
      <view wx:if="{{loading}}" class="loading-state">
        <view class="loading-spinner"></view>
        <text class="loading-text">正在获取地址信息...</text>
      </view>
      
      <!-- 错误状态 -->
      <view wx:elif="{{error}}" class="error-state">
        <text class="error-icon">⚠</text>
        <text class="error-text">{{error}}</text>
        <button class="retry-btn" bindtap="getAddressList" data-lat="{{latitude}}" data-lng="{{longitude}}">重试</button>
      </view>
      
      <!-- 地址列表 -->
      <view wx:else class="address-list">
        <view wx:if="{{addressList.length === 0}}" class="empty-state">
          <text class="empty-text">暂无地址信息</text>
        </view>
        
        <view wx:else>
          <view 
            wx:for="{{addressList}}" 
            wx:key="index" 
            class="address-item {{selectedIndex === index ? 'selected' : ''}}"
            bindtap="selectAddress"
            data-index="{{index}}"
          >
            <view class="address-main">
              <view class="address-title">{{item.address}}</view>
              <view class="address-detail">{{item.detail}}</view>
            </view>
            <view class="address-meta">
              <view class="address-type">{{item.type}}</view>
              <view wx:if="{{item.distance}}" class="address-distance">{{item.distance}}m</view>
            </view>
            <view class="select-indicator">
              <text class="check-icon" wx:if="{{selectedIndex === index}}">✓</text>
            </view>
          </view>
        </view>
      </view>
    </view>
    
    <!-- 底部按钮 -->
    <view class="panel-footer" wx:if="{{!loading && !error && addressList.length > 0}}">
      <button class="cancel-btn" bindtap="close">取消</button>
      <button 
        class="confirm-btn {{selectedIndex >= 0 ? 'active' : 'disabled'}}" 
        bindtap="confirmSelect"
        disabled="{{selectedIndex < 0}}"
      >
        确认选择
      </button>
    </view>
  </view>
</view>