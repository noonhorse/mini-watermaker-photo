  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
  opacity: 0.9;
}

.blue-time {
  font-size: 42rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.blue-name {
  font-size: 32rpx;
  margin-bottom: 8rpx;
}

.blue-date,
