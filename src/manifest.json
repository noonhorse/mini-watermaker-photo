{
	"name": "水印打卡相机",
	"appid": "__UNI__WATERMARK",
	"description": "一款功能强大的水印相机应用，支持GPS定位、时间水印、自定义Logo等功能",
	"versionName": "1.0.0",
	"versionCode": "100",
	"transformPx": false,
	"locale": "zh-Hans",

	"app-plus": {
		"usingComponents": true,
		"nvueStyleCompiler": "uni-app",
		"compilerVersion": 3,
		"splashscreen": {
			"alwaysShowBeforeRender": true,
			"waiting": true,
			"autoclose": true,
			"delay": 0
		},
		"modules": {
			"Camera": {},
			"Maps": {},
			"Share": {},
			"Geolocation": {}
		},
		"distribute": {
			"android": {
				"permissions": [
					"<uses-permission android:name=\"android.permission.CAMERA\"/>",
					"<uses-permission android:name=\"android.permission.ACCESS_FINE_LOCATION\"/>",
					"<uses-permission android:name=\"android.permission.ACCESS_COARSE_LOCATION\"/>",
					"<uses-permission android:name=\"android.permission.WRITE_EXTERNAL_STORAGE\"/>",
					"<uses-permission android:name=\"android.permission.READ_EXTERNAL_STORAGE\"/>"
				]
			},
			"ios": {
				"privacyDescription": {
					"NSCameraUsageDescription": "需要使用相机进行拍照",
					"NSLocationWhenInUseUsageDescription": "需要获取您的位置信息来添加地址水印",
					"NSPhotoLibraryAddUsageDescription": "需要访问相册保存照片",
					"NSPhotoLibraryUsageDescription": "需要访问相册选择Logo"
				}
			},
			"sdkConfigs": {}
		}
	},

	"mp-weixin": {
		"appid": "wxc40c7974a436aeb3",
		"setting": {
			"urlCheck": true,
			"es6": true,
			"enhance": true,
			"postcss": true,
			"minified": true
		},
		"usingComponents": true,
		"permission": {
			"scope.userLocation": {
				"desc": "你的位置信息将用于显示地址水印"
			},
			"scope.camera": {
				"desc": "需要使用相机进行拍照"
			}
		},
		"requiredBackgroundModes": ["location"],
		"optimization": {
			"subPackages": true
		}
	},

	"mp-alipay": {
		"usingComponents": true
	},

	"mp-baidu": {
		"usingComponents": true
	},

	"mp-toutiao": {
		"usingComponents": true
	},

	"mp-lark": {
		"usingComponents": true,
		"appid": "",
		"setting": {
			"es6": true,
			"postcss": true,
			"minified": true
		},
		"permission": {
			"scope.userLocation": {
				"desc": "你的位置信息将用于显示地址水印"
			},
			"scope.camera": {
				"desc": "需要使用相机进行拍照"
			}
		},
		"requiredBackgroundModes": ["location"]
	},

	"mp-qq": {
		"usingComponents": true
	},

	"mp-kuaishou": {
		"usingComponents": true
	},

	"mp-dingtalk": {
		"usingComponents": true,
		"appid": "",
		"setting": {
			"es6": true,
			"postcss": true,
			"minified": true
		},
		"permission": {
			"scope.userLocation": {
				"desc": "你的位置信息将用于显示地址水印"
			},
			"scope.camera": {
				"desc": "需要使用相机进行拍照"
			}
		},
		"requiredBackgroundModes": ["location"]
	},

	"h5": {
		"devServer": {
			"port": 8080,
			"disableHostCheck": true,
			"proxy": {},
			"https": false
		},
		"title": "水印打卡相机",
		"router": {
			"mode": "hash"
		},
		"optimization": {
			"treeShaking": {
				"enable": true
			}
		}
	},

	"uniStatistics": {
		"enable": false
	}
}
