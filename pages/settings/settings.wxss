/* pages/settings/settings.wxss */
.settings-container {
  width: 100vw;
  height: 100vh;
  background: #f2f2f7;
  display: flex;
  flex-direction: column;
}
/* 设置内容 */
.settings-content {
  flex: 1;
  padding: 0;
}

/* 分组标题 */
.section-header {
  padding: 32rpx 32rpx 16rpx;
  font-size: 26rpx;
  color: #6d6d72;
  text-transform: uppercase;
  font-weight: 400;
  letter-spacing: 0.5rpx;
}

/* 设置分组 */
.setting-group {
  background: #fff;
  margin: 0 32rpx 32rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

/* 设置项 */
.setting-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #c6c6c8;
  min-height: 88rpx;
  position: relative;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-item:active {
  background: #d1d1d6;
}

.item-icon {
  width: 58rpx;
  height: 58rpx;
  margin-right: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.item-label {
  font-size: 34rpx;
  color: #000;
  flex: 1;
  font-weight: 400;
}

.item-value {
  font-size: 34rpx;
  color: #8e8e93;
  margin-right: 16rpx;
}

.item-status {
  font-size: 24rpx;
  color: #ff3b30;
  margin-right: 16rpx;
}

.item-arrow {
  font-size: 36rpx;
  color: #c7c7cc;
  font-weight: 300;
}

/* 退出账号特殊样式 */
.logout-group {
  margin-top: 64rpx;
}

.logout-item {
  justify-content: center;
}

.logout-icon {
  color: #ff3b30;
}

.logout-label {
  color: #ff3b30;
  text-align: center;
  margin-left: 0;
}

/* 动画效果 */
.setting-group {
  animation: slideIn 0.3s ease-out;
}

@keyframes slideIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 响应式设计 */
@media (max-width: 750rpx) {
  .nav-bar {
    padding: calc(44px + env(safe-area-inset-top)) 24rpx 24rpx;
  }
  
  .setting-group {
    margin: 0 24rpx 24rpx;
  }
  
  .section-header {
    padding: 24rpx 24rpx 12rpx;
  }
}

/* 深色模式适配 */
@media (prefers-color-scheme: dark) {
  .settings-container {
    background: #000;
  }
  
  .nav-bar {
    background: #000;
    border-bottom-color: #38383a;
  }
  
  .nav-title {
    color: #fff;
  }
  
  .section-header {
    color: #8e8e93;
  }
  
  .setting-group {
    background: #1c1c1e;
  }
  
  .setting-item {
    border-bottom-color: #38383a;
  }
  
  .setting-item:active {
    background: #2c2c2e;
  }
  
  .item-label {
    color: #fff;
  }
  
  .item-value {
    color: #8e8e93;
  }
}