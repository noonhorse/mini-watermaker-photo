<!--pages/camera/camera.wxml-->
<view class="camera-container" bindtap="onPageTap">
  <!-- 左上角设置按钮 -->
  <view class="function-area">
      <view class="watermark-top-left">
        <!-- 设置按钮 -->
        <!-- <view class="setting-btn" bindtap="goToSettings">
          <image class="icon-setting" src="/static/setting.png" mode="aspectFit"></image>
        </view> -->
        <!-- 闪光灯按钮 -->
        <view class="flash-btn" bindtap="toggleFlash">
          <image wx:if="{{flashMode === 'on'}}" class="flash-icon" src="/static/flashlight.png" mode="aspectFit"></image>
          <image wx:elif="{{flashMode === 'off'}}" class="flash-icon" src="/static/flashlight-turned-off.png" mode="aspectFit"></image>
          <image wx:else class="flash-icon" src="/static/flashlight-auto.png" mode="aspectFit"></image>
          <text class="flash-text">灯光</text>
        </view>
        <!-- 视频/图片切换 按钮 先屏蔽-->
        <!-- <view class="flash-btn" bindtap="toggleVideo">
          <image wx:if="{{mediaType !== 'image'}}" class="flash-icon" src="/static/pic-pictures.png" mode="aspectFit"></image>
          <image wx:else class="flash-icon" src="/static/video.png" mode="aspectFit"></image>
          <text class="flash-text">{{mediaType === 'image' ? '视频' : '图片' }}</text>
        </view> -->
      </view>
  </view>
  <!-- 毛玻璃背景图（权限未授权或摄像头错误时显示） -->
  <view wx:if="{{!hasPermissions || showError}}" class="background-blur">
    <image class="background-image" src="/static/bg.jpg" mode="aspectFill"></image>
    <view class="blur-overlay"></view>
  </view>
  
  <!-- 相机预览区域 -->
    <camera wx:if="{{hasPermissions}}" 
      class="camera-preview {{orientation}}"
      device-position="{{cameraPosition}}"
      flash="{{flashMode}}"
      zoom="{{zoomLevel}}"
      binderror="onCameraError"
      bindstop="onCameraStop"
      bindready="onCameraReady"
      bindtouchstart="onTouchStart"
      bindtouchmove="onTouchMove"
      bindtouchend="onTouchEnd"
    >
    <!-- 水印显示组件 -->
    <watermark-display 
      watermark-id="{{currentWatermarkId}}"
      visible="{{true}}"
    ></watermark-display>
    
    <!-- 倒计时显示 -->
    <cover-view wx:if="{{timerCount > 0}}" class="timer-overlay">
      <cover-view class="timer-count">{{timerCount}}</cover-view>
    </cover-view>
  </camera>
   <!-- 水印列表面板 -->
    <watermark-list 
      show="{{showWatermarkPanel}}" 
      bind:onclose="hideWatermarkPanel" 
      bind:onselect="onWatermarkSelect"
    ></watermark-list>
  <!-- 底部控制栏 (20%高度) -->
  <view class="bottom-controls-new">
    <!-- 水印设置按钮 -->
    <view class="control-btn-new" bindtap="showWatermarkPanel">
      <image class="btn-icon-new" src="/static/shuiyin.png" mode="aspectFit"></image>
      <view class="btn-text-new">水印设置</view>
    </view>
    
    <!-- 拍照按钮 -->
    <view class="shutter-btn-new {{isCapturing ? 'capturing' : ''}}" bindtap="takePhoto">
      <view class="shutter-inner-new" wx:if="{{hasPermissions}}"></view>
      <view class="permission-text-new" wx:else>点击授权</view>
    </view>
    
    <!-- 切换摄像头按钮 -->
    <view class="control-btn-new" bindtap="switchCamera">
      <image class="btn-icon-new" src="/static/switch_camera.png" mode="aspectFit"></image>
      <view class="btn-text-new">切换</view>
    </view>
  </view>
  
  <!-- 权限提示tooltip -->
  <view class="permission-tooltip" wx:if="{{showPermissionTooltip}}">
    <view class="tooltip-content">
      <view class="tooltip-text">点击授权摄像头和位置权限</view>
      <view class="tooltip-buttons">
        <button class="tooltip-btn" bindtap="requestPermissions">去授权</button>
        <button class="tooltip-btn secondary" bindtap="hidePermissionTooltip">取消</button>
      </view>
    </view>
    <view class="tooltip-arrow"></view>
  </view>
  
  <!-- 功能按钮区域 -->
  <view class="function-controls">
    
    
    <!-- 定时器按钮 -->
    <!-- <view class="function-btn" bindtap="toggleTimer">
      <image class="function-icon" src="/static/dingshirenwu.png" mode="aspectFit"></image>
      <view wx:if="{{settings.timerSeconds > 0}}" class="timer-badge">{{settings.timerSeconds}}s</view>
    </view> -->
    
    <!-- 缩放控制 -->
    <!-- <view class="zoom-control">
      <view class="zoom-info">{{zoomLevel.toFixed(1)}}x</view>
      <slider 
        class="zoom-slider"
        min="{{minZoom}}"
        max="{{maxZoom}}"
        step="0.1"
        value="{{zoomLevel}}"
        bindchange="onZoomChange"
      />
      <view class="zoom-buttons">
        <button class="zoom-btn" bindtap="zoomOut">-</button>
        <button class="zoom-btn" bindtap="zoomIn">+</button>
      </view>
    </view> -->
  </view>
</view>

<!-- 加载提示 -->
<view wx:if="{{isLoading}}" class="loading-overlay">
  <view class="loading-content">
    <view class="loading-spinner"></view>
    <view class="loading-text">{{loadingText}}</view>
  </view>
</view>
<!-- 隐藏的canvas用于水印处理 -->
<canvas 
  id="watermarkCanvas" 
  type="2d" 
  style="position: fixed; top: -9999px; left: -9999px; width: 1px; height: 1px;"
></canvas>